# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.history
.svn/
.idea/
*.iml
*.ipr
*.iws

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Godot imported caches and local export credentials
godot/.godot/
godot/export_credentials.cfg
godot/builds/

# Blender and Python working files from the art pipelines
**/*.blend1
**/__pycache__/

# Textures Godot extracts from enemy_healer.glb / enemy_warrior.glb on import.
# The .glb carries them, the importer writes them back out beside it, and they
# are large. Regenerated on any fresh import, so they are not worth tracking.
godot/assets/models/enemy_healer_*
godot/assets/models/enemy_warrior_*

# Flutter/Dart scaffolding and build output. The Flutter prototype was removed in
# 268bb6f, but running any flutter command at the root regenerates these - and
# .flutter-plugins-dependencies says in its own first line not to check it in.
# Anchored to the root so an art pipeline's own build/ directory is unaffected.
/build/
/.dart_tool/
/.flutter-plugins-dependencies
/android/
/ios/
/linux/
/macos/
/windows/
