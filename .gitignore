# Miscellaneous
# Unity migration (keep Assets, Packages and ProjectSettings tracked).
/unity/Library/
/unity/Temp/
/unity/Obj/
/unity/Logs/
/unity/UserSettings/
/unity/Builds/
/unity/*.csproj
/unity/*.sln
/unity/*.slnx
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.history
.svn/
.idea/
*.iml
*.ipr
*.iws

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Blender and Python working files from the art pipelines
**/*.blend1
**/__pycache__/

# Local Unity/editor junk
unity/.vscode/
unity/Assets/_Recovery/
unity/Assets/_Recovery.meta
unity/mono_crash.*
